# ============================================================================
# Backend Integration Tests Environment Configuration
# Location: backend/tests/integration/.env.integration
# ============================================================================

APP_NAME=Enterprise RAG API (Integration)
APP_ENV=integration
DEBUG=false

# GCP / Storage
GCP_PROJECT_ID=ai-agent-learning-2026
GCP_REGION=asia-south1
GCP_AUTH_MODE=local
GCS_DOCUMENT_BUCKET=ai-agent-learning-2026-enterprise-rag-documents

# API Security (used by integration_client fixture)
API_KEY=integration-secret-key
RATE_LIMIT_PER_MINUTE=10

# Salesforce EDH Connector Integration Settings
# Replace the placeholder values below with your Salesforce Org / Sandbox Connected App credentials
# to run test_salesforce_edh_integration.py against a real Salesforce org:
SF_INSTANCE_URL=https://your-org.my.salesforce.com
SF_CLIENT_ID=your-salesforce-client-id
SF_CLIENT_SECRET=your-salesforce-client-secret
SF_API_VERSION=v60.0
SF_ACCESS_TOKEN=

# Databricks EDH Connector Integration Settings
# Populate DATABRICKS_HOST + either DATABRICKS_TOKEN or (DATABRICKS_CLIENT_ID & DATABRICKS_CLIENT_SECRET)
# to run test_live_databricks_workspace_when_env_configured against a real Databricks workspace:
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
DATABRICKS_WAREHOUSE_ID=default
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=default
DATABRICKS_TEST_TABLE=rag_chunks

