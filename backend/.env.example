# Application
APP_NAME=Enterprise RAG API
APP_ENV=development
DEBUG=true

# GCP Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-south1

# ---------------------------------------------------------------------------
# GCP Authentication Mode
# ---------------------------------------------------------------------------
# Accepted values:
#   adc  – Application Default Credentials.
#           For local development only (run: gcloud auth application-default login).
#           Automatically REJECTED in production / staging environments.
#   wif  – Workload Identity Federation.
#           Required in production and staging.
#           Requires at least one of the WIF options below.
# ---------------------------------------------------------------------------
GCP_AUTH_MODE=adc

# Workload Identity Federation (WIF) — required when GCP_AUTH_MODE=wif.
#
# Option A: External-account JSON credential file (preferred for CI/CD).
GCP_WIF_CREDENTIAL_FILE=
# Example: GCP_WIF_CREDENTIAL_FILE=/secrets/wif-credentials.json

# Option B: Provider resource name + service account e-mail
#           (used when running on Cloud Run / GKE with WIF attached identity).
GCP_WIF_PROVIDER=
# Example: GCP_WIF_PROVIDER=projects/123456789012/locations/global/workloadIdentityPools/my-pool/providers/my-provider
GCP_WIF_SERVICE_ACCOUNT=
# Example: GCP_WIF_SERVICE_ACCOUNT=svc-rag@your-gcp-project-id.iam.gserviceaccount.com

# Optional: impersonate a target service account after initial auth.
GCP_IMPERSONATE_SERVICE_ACCOUNT=
# Example: GCP_IMPERSONATE_SERVICE_ACCOUNT=svc-rag@your-gcp-project-id.iam.gserviceaccount.com

# OAuth2 scopes (comma-separated). Defaults to cloud-platform if not set.
GCP_DEFAULT_SCOPES=https://www.googleapis.com/auth/cloud-platform
# For least-privilege, replace with the narrowest required scopes, e.g.:
# GCP_DEFAULT_SCOPES=https://www.googleapis.com/auth/devstorage.read_write

# Google Cloud Storage
GCS_DOCUMENT_BUCKET=your-document-bucket

# Vertex AI
VERTEX_AI_ENABLED=true

# Qdrant
QDRANT_URL=
QDRANT_API_KEY=

# LLM Configuration
LLM_PROVIDER=vertex_ai
