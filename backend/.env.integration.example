# Integration test environment template (copy to .env.integration)
APP_NAME=Enterprise RAG API (Integration)
APP_ENV=integration
DEBUG=false

# GCP
GCP_PROJECT_ID=ai-agent-learning-2026
GCP_REGION=asia-south1
GCP_AUTH_MODE=local
GCP_CREDENTIAL_FILE=
GCP_DEFAULT_SCOPES=https://www.googleapis.com/auth/cloud-platform
GCP_IMPERSONATE_SERVICE_ACCOUNT=svc-rag-dev@ai-agent-learning-2026.iam.gserviceaccount.com

# Storage / AI
GCS_DOCUMENT_BUCKET=ai-agent-learning-2026-enterprise-rag-documents
VERTEX_AI_ENABLED=true
LLM_PROVIDER=vertex_ai

# Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# API Security
API_KEY=integration-secret-key
RATE_LIMIT_PER_MINUTE=60

# Salesforce EDH Connector Integration Settings
SF_INSTANCE_URL=https://your-org.my.salesforce.com
SF_CLIENT_ID=your-connected-app-client-id
SF_CLIENT_SECRET=your-connected-app-client-secret
SF_TEST_SOBJECT=Account
