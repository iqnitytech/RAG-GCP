# ============================================================================
# SDK Integration Tests Environment Configuration
# Location: rag-platform-sdk/tests/integration/.env.integration
# ============================================================================

# Namespace / Zone defaults for integration tests
EDH_NAMESPACE=crm-edh
EDH_DATA_LAKE_ROOT=./.test_data_lake

# 1. Salesforce EDH Strategy (strategy="salesforce")
# Fill in your Salesforce Org / Sandbox Connected App credentials below to run
# test_live_salesforce_org_from_integration_env against a real Salesforce org:
SF_INSTANCE_URL=
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_API_VERSION=v60.0
SF_TEST_SOBJECT=Account

# 2. API-Driven EDH Hub Strategy (strategy="api_hub")
EDH_API_HUB_URL=
EDH_API_HUB_TOKEN=
EDH_API_HUB_KEY=

# 3. Object Storage Hub Strategy (strategy="object_storage_hub")
EDH_S3_ENDPOINT_URL=
EDH_S3_REGION=asia-south1
EDH_S3_ACCESS_KEY=
EDH_S3_SECRET_KEY=

# 4. Databricks Unity Catalog & SQL Strategy (strategy="databricks")
# Populate DATABRICKS_HOST + either DATABRICKS_TOKEN or (DATABRICKS_CLIENT_ID & DATABRICKS_CLIENT_SECRET)
# to run test_live_databricks_workspace_from_integration_env against a real Databricks workspace:
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
DATABRICKS_WAREHOUSE_ID=default
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=default
DATABRICKS_TEST_TABLE=rag_chunks

