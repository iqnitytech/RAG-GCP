# Local development
APP_ENV=local
AUTH_MODE=dev                 # dev | entra
LLM_MODE=mock                 # mock | vertex
# Vertex AI (LLM_MODE=vertex). Default auth = ADC / Cloud Run service account (roles/aiplatform.user), no key needed.
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
VERTEX_MODEL_ROUTING=gemini-2.5-flash     # which agents
VERTEX_MODEL_TOOLS=gemini-2.5-flash       # which tool + arguments
VERTEX_MODEL_SYNTHESIS=gemini-2.5-pro     # final answer
# VERTEX_MODEL=                           # optional: one model for all roles
VERTEX_API_KEY=                           # optional (express mode). Secret Manager only: --set-secrets VERTEX_API_KEY=...
LLM_TIMEOUT_S=30
SKILL_SELECTION=llm           # llm = LLM picks skills (falls back to ROUTING) | off
SKILL_MAX_STEPS=4             # hard cap on skills chosen per question
EMBEDDER=hash                 # hash (offline) | vertex | none ; shortlist only kicks in above SKILL_SHORTLIST_SIZE skills
SKILL_SHORTLIST_SIZE=12
VERTEX_MODEL_EMBEDDING=text-embedding-005
ROUTING=hybrid                # keyword | skill | llm | hybrid (keyword -> skill -> llm)
SF_MODE=mock                  # mock | sdk
MCP_TRANSPORT=inprocess       # inprocess | streamable_http

# Entra (AUTH_MODE=entra)
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=api://<chat-api-app-id>

# Per-MCP URLs (MCP_TRANSPORT=streamable_http)
MCP_MACHINE_URL=http://localhost:8101/mcp
MCP_CUSTOMER_URL=http://localhost:8102/mcp
MCP_TELEMETRY_URL=http://localhost:8103/mcp

# Service-to-service (prod: MCP_AUTH=google, secret from Secret Manager)
MCP_AUTH=none
USER_CONTEXT_SECRET=local-dev-secret
MCP_ALLOWED_CALLER_SA=

# Registry (prod: firestore + manual skill approval)
REGISTRY_STORE=yaml           # yaml | firestore
REGISTRY_PREFIX=registry
FIRESTORE_PROJECT=
SKILLS_AUTO_APPROVE=true      # must be false in prod
