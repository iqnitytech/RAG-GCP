# Local development
APP_ENV=local
# dev | entra
AUTH_MODE=dev
# mock | vertex
LLM_MODE=mock
# Vertex AI (LLM_MODE=vertex). Default auth = ADC / Cloud Run service account (roles/aiplatform.user), no key needed.
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
# which agents
VERTEX_MODEL_ROUTING=gemini-2.5-flash
# which tool + arguments
VERTEX_MODEL_TOOLS=gemini-2.5-flash
# final answer
VERTEX_MODEL_SYNTHESIS=gemini-2.5-pro
# optional: one model for all roles
# VERTEX_MODEL=
# optional (express mode). Secret Manager only: --set-secrets VERTEX_API_KEY=...
VERTEX_API_KEY=
LLM_TIMEOUT_S=30
# llm = LLM picks skills (falls back to ROUTING) | off
SKILL_SELECTION=llm
# hard cap on skills chosen per question
SKILL_MAX_STEPS=4
# hash (offline) | vertex | none ; shortlist only kicks in above SKILL_SHORTLIST_SIZE skills
EMBEDDER=hash
SKILL_SHORTLIST_SIZE=12
VERTEX_MODEL_EMBEDDING=text-embedding-005
# keyword | skill | llm | hybrid (keyword -> skill -> llm)
ROUTING=hybrid
# mock | sdk
SF_MODE=mock
# inprocess | streamable_http
MCP_TRANSPORT=inprocess

# Entra (AUTH_MODE=entra)
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=api://<chat-api-app-id>

# Per-MCP URLs (MCP_TRANSPORT=streamable_http)
MCP_MACHINE_URL=http://localhost:8101/mcp
MCP_CUSTOMER_URL=http://localhost:8102/mcp
MCP_TELEMETRY_URL=http://localhost:8103/mcp

# Service-to-service (prod: MCP_AUTH=google, secret from Secret Manager)
MCP_AUTH=none
USER_CONTEXT_SECRET=local-dev-secret
MCP_ALLOWED_CALLER_SA=

# Registry (prod: firestore + manual skill approval)
# yaml | firestore
REGISTRY_STORE=yaml
REGISTRY_PREFIX=registry
FIRESTORE_PROJECT=
# must be false in prod
SKILLS_AUTO_APPROVE=true

SF_INSTANCE_URL="http://instance.com"
SF_CLIENT_ID="SF_CLIENT_ID"
SF_CLIENT_SECRET="SF_CLIENT_SECRET"
SF_API_VERSION=v60.0

SDK_API_KEY="SDK_API_KEY"
SDK_BASE_URL="http://base.com"
